# ARVEX CLOUD - ENVIRONMENT CONFIGURATION

# ==================== NODE ENVIRONMENT ====================
NODE_ENV=production

# ==================== DATABASE ====================
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=arvex
DATABASE_PASSWORD=arvex_secure_password_change_me
DATABASE_NAME=arvex_cloud
DATABASE_URL=postgresql://arvex:arvex_secure_password_change_me@postgres:5432/arvex_cloud

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=arvex_redis_password_change_me
REDIS_URL=redis://:arvex_redis_password_change_me@redis:6379
REDIS_DB=0

# ==================== BACKEND ====================
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
API_PREFIX=/api
API_VERSION=v1

# ==================== FRONTEND ====================
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ==================== SECURITY ====================
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10
REFRESH_TOKEN_EXPIRES_IN=7d

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# ==================== EMAIL ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@arvex.cloud
MAIL_FROM_NAME=ARVEX CLOUD

# ==================== PAYMENT INTEGRATION ====================
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# ==================== NODE AGENT ====================
NODE_AGENT_URL=http://node-agent:7777
NODE_AGENT_SECRET=your_node_agent_secret_key

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== FEATURES ====================
ENABLE_OAUTH_GOOGLE=false
ENABLE_OAUTH_DISCORD=false
ENABLE_2FA=true
ENABLE_API_DOCS=true
ENABLE_MONITORING=true

# ==================== MONITORING ====================
SENTRY_DSN=
MONITORING_ENABLED=true

# ==================== DEVELOPMENT ====================
DEBUG=false
DEBUG_NAMESPACE=arvex:*
