# ARVEX NODE AGENT CONFIGURATION

# Node Identity
NODE_ID=node-001
NODE_NAME=Production VPS Node 1
NODE_SECRET=your_secure_node_secret_key_here

# API Server Connection
API_URL=http://localhost:3000
API_KEY=your_api_key_here
API_TIMEOUT=30000

# LXC/LXD Configuration
LXD_SOCKET=/var/snap/lxd/common/lxd.sock
LXD_REMOTE=local
LXC_NETWORK_BRIDGE=lxdbr0
LXC_STORAGE_POOL=default

# System Configuration
MAX_VPS=100
CPU_CORES=$(nproc)
TOTAL_MEMORY_GB=64
STORAGE_PATH=/var/lib/lxd/storage-pools/default

# Monitoring
MONITOR_INTERVAL=5000
HEARTBEAT_INTERVAL=10000
STATS_REPORT_INTERVAL=15000

# Security
USE_SSL=false
SSL_CERT_PATH=/etc/lxd/client.crt
SSL_KEY_PATH=/etc/lxd/client.key
SSL_CA_PATH=/etc/lxd/ca.crt

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/arvex-node-agent.log

# Port
PORT=7777

# Environment
NODE_ENV=production
