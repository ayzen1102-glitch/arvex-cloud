# Node Agent Configuration
NODE_AGENT_ID=node-1
NODE_AGENT_TOKEN=your-secure-token-here
NODE_AGENT_PORT=8085

# Backend API Configuration
BACKEND_API_URL=http://localhost:3000
BACKEND_API_KEY=your-api-key

# LXC/LXD Configuration
LXD_SOCKET_PATH=/var/snap/lxd/common/lxd.sock
LXD_TRUST_PASSWORD=your-lxd-trust-password
LXC_IMAGES_SERVER=https://images.linuxcontainers.org

# System
NODE_ENV=production
LOG_LEVEL=info
MONITOR_INTERVAL=60000

# WebSocket
WS_ENABLED=true
WS_RECONNECT_INTERVAL=5000
